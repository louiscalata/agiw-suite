<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Jaryo scale (jaryo/tokens.json). Space is a 4dp rhythm.
      Type is sp so font scaling changes the size.
      The Android touch floor is 48dp (space_7). The kit control minimum is 44px.
    -->
    <dimen name="space_1">4dp</dimen>
    <dimen name="space_2">8dp</dimen>
    <dimen name="space_3">12dp</dimen>
    <dimen name="space_4">16dp</dimen>
    <dimen name="space_5">24dp</dimen>
    <dimen name="space_6">32dp</dimen>
    <dimen name="space_7">48dp</dimen>
    <dimen name="space_8">64dp</dimen>
    <dimen name="type_meta">11sp</dimen>
    <dimen name="type_ui">13sp</dimen>
    <dimen name="type_body">14sp</dimen>
    <dimen name="type_name">16sp</dimen>
    <dimen name="type_title">20sp</dimen>
    <dimen name="type_display">28sp</dimen>
    <dimen name="border_width">1dp</dimen>
    <dimen name="focus_width">3dp</dimen>
    <item name="tracking_wordmark" format="float" type="dimen">0.02</item>
    <item name="tracking_meta" format="float" type="dimen">0.08</item>
    <item name="leading_meta" format="float" type="dimen">1.4</item>
    <item name="leading_ui" format="float" type="dimen">1.4</item>
    <item name="leading_body" format="float" type="dimen">1.45</item>
    <item name="leading_title" format="float" type="dimen">1.2</item>
    <item name="leading_display" format="float" type="dimen">1.15</item>
</resources>
