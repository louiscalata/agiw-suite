<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <solid android:color="@color/agiw_bg"/>
            <stroke android:width="@dimen/border_width" android:color="@color/agiw_ink"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <solid android:color="@color/agiw_ink"/>
            <stroke android:width="@dimen/focus_width" android:color="@color/agiw_bg"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <solid android:color="@color/agiw_ink"/>
        </shape>
    </item>
</selector>
