<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agiw_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_3">
    <TextView
        android:id="@+id/widgetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="@dimen/tracking_wordmark"
        android:text="@string/wordmark"
        android:textColor="@color/agiw_ink"
        android:textSize="@dimen/type_display"/>
    <TextView
        android:id="@+id/widgetRule"
        android:layout_width="@dimen/space_8"
        android:layout_height="@dimen/border_width"
        android:layout_marginTop="@dimen/space_2"
        android:background="@color/agiw_ink"
        android:importantForAccessibility="no"
        android:text=""
        android:textColor="@color/agiw_ink"/>
    <TextView
        android:id="@+id/widgetProcess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/agiw_ink"
        android:textSize="@dimen/type_title"/>
    <TextView
        android:id="@+id/widgetAcceptance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/agiw_ink"
        android:textSize="@dimen/type_body"/>
    <TextView
        android:id="@+id/widgetConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/agiw_ink"
        android:textSize="@dimen/type_body"/>
    <TextView
        android:id="@+id/widgetDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="3"
        android:textColor="@color/agiw_ink"
        android:textSize="@dimen/type_body"/>
</LinearLayout>
