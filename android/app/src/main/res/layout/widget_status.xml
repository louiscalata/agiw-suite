<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agiw_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/widgetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:text="AGIW"
        android:textColor="@color/agiw_ink"
        android:textSize="22sp"/>
    <TextView
        android:id="@+id/widgetRule"
        android:importantForAccessibility="no"
        android:layout_width="72dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@color/agiw_ink"
        android:text=""
        android:textColor="@color/agiw_ink"/>
    <TextView
        android:id="@+id/widgetProcess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/agiw_ink"
        android:textSize="20sp"/>
    <TextView
        android:id="@+id/widgetAcceptance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/agiw_ink"
        android:textSize="13sp"/>
    <TextView
        android:id="@+id/widgetConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/agiw_ink"
        android:textSize="14sp"/>
    <TextView
        android:id="@+id/widgetDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="3"
        android:textColor="@color/agiw_ink"
        android:textSize="14sp"/>
</LinearLayout>
