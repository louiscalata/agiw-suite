<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:isScrollContainer="true"
    android:paddingBottom="24dp"
    android:paddingEnd="12dp"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:scrollbarSize="@dimen/space_1"
    android:scrollbarThumbVertical="@drawable/agiw_scrollbar"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_2">
        <TextView
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/wordmark"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="@dimen/tracking_wordmark"
            android:lineSpacingMultiplier="@dimen/leading_display"
            android:text="@string/wordmark"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_display"/>
        <View
            android:id="@+id/schematic"
            android:layout_width="@dimen/space_8"
            android:layout_height="@dimen/border_width"
            android:layout_marginTop="@dimen/space_3"
            android:background="@color/agiw_ink"
            android:contentDescription="@string/schematic_description"/>
        <TextView
            android:id="@+id/posture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center_horizontal"
            android:letterSpacing="@dimen/tracking_meta"
            android:lineSpacingMultiplier="@dimen/leading_meta"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_meta"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/process"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_title"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_title"/>
        <TextView
            android:id="@+id/acceptance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_body"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_body"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <Button
            android:id="@+id/read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/agiw_button"
            android:contentDescription="@string/read_description"
            android:elevation="0dp"
            android:fontFamily="@font/inter_semibold"
            android:minHeight="@dimen/space_7"
            android:minWidth="@dimen/space_7"
            android:paddingEnd="@dimen/space_4"
            android:paddingStart="@dimen/space_4"
            android:stateListAnimator="@null"
            android:text="@string/read"
            android:textAllCaps="false"
            android:textColor="@color/agiw_button_text"
            android:textSize="@dimen/type_name"/>
        <TextView
            android:id="@+id/lane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_body"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <TextView
            android:id="@+id/attachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_body"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <TextView
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_body"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <TextView
            android:id="@+id/observed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_ui"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_ui"/>
        <Button
            android:id="@+id/receiptsToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:background="@drawable/agiw_text_button"
            android:contentDescription="@string/receipts_show_description"
            android:elevation="0dp"
            android:fontFamily="@font/inter_semibold"
            android:minHeight="@dimen/space_7"
            android:minWidth="@dimen/space_7"
            android:stateListAnimator="@null"
            android:text="@string/receipts"
            android:textAllCaps="false"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_body"/>
        <TextView
            android:id="@+id/receipts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="@dimen/leading_ui"
            android:textColor="@color/agiw_ink"
            android:textSize="@dimen/type_ui"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
