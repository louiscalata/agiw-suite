<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:isScrollContainer="true"
    android:paddingBottom="24dp"
    android:paddingEnd="12dp"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:scrollbarSize="4dp"
    android:scrollbarThumbVertical="@drawable/agiw_scrollbar"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/wordmark"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/agiw_ink"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/wordmark"
            android:textSize="28sp"/>
        <View
            android:id="@+id/schematic"
            android:layout_width="72dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/agiw_ink"
            android:contentDescription="@string/schematic_description"/>
        <TextView
            android:id="@+id/process"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/agiw_ink"
            android:gravity="center_horizontal"
            android:textSize="22sp"/>
        <TextView
            android:id="@+id/acceptance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/agiw_ink"
            android:gravity="center_horizontal"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="14sp"/>
        <Button
            android:id="@+id/read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/agiw_ink"
            android:backgroundTint="@color/agiw_ink"
            android:contentDescription="@string/read_description"
            android:fontFamily="@font/inter_semibold"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:text="@string/read"
            android:textAllCaps="false"
            android:textColor="@color/agiw_bg"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/lane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/attachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/observed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/receiptsToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="@string/receipts_show_description"
            android:fontFamily="@font/inter_semibold"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:text="@string/receipts"
            android:textAllCaps="false"
            android:textColor="@color/agiw_ink"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/receipts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_horizontal"
            android:textSize="12sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
