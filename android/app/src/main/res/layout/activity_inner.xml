<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:isScrollContainer="true"
    android:paddingBottom="24dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="24dp"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.14"
            android:text="INFERENCE MONITOR"
            android:textAllCaps="true"
            android:textSize="11sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="AGIW"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="AGIW"
            android:textSize="36sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:text="Read-only overview. One snapshot at a time."
            android:textSize="16sp"/>
        <View
            android:id="@+id/schematic"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/agiw_ink"
            android:contentDescription="Schematic rule"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.14"
            android:text="CONNECTION"
            android:textSize="11sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:text="Type an https address. This app does not repair a run."
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/agiw_field"
            android:fontFamily="@font/inter_regular"
            android:hint="https address"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:textSize="16sp"/>
        <Button
            android:id="@+id/read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/agiw_ink"
            android:backgroundTint="@color/agiw_ink"
            android:contentDescription="Read the observer snapshot"
            android:fontFamily="@font/inter_semibold"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="Read"
            android:textAllCaps="false"
            android:textColor="@color/agiw_bg"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="16sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.14"
            android:text="OVERVIEW"
            android:textSize="11sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="PROCESS"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/process"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textSize="20sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="LANE"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/lane"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textSize="20sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="ATTACH"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/attachment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textSize="20sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="CONNECT"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textSize="20sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="TIME"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/observed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textSize="16sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/agiw_ink"/>
        <TextView
            android:id="@+id/acceptance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semibold"
            android:textSize="16sp"/>
        <Button
            android:id="@+id/receiptsToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="Show recorded receipts. They are not a pass."
            android:fontFamily="@font/inter_semibold"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:text="Receipts"
            android:textAllCaps="false"
            android:textColor="@color/agiw_ink"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/receipts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textSize="14sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
