# Preserve the exact public release bytes used by the pinned Nisi manifest.
vendor/nisi/package/** -text
# The upstream Apache license ends with a blank line; preserve it unchanged.
vendor/nisi/package/LICENSE whitespace=-blank-at-eof
# Source and web assets are LF on every checkout (Windows clones with core.autocrlf=true included), so
# byte-sensitive tests and served assets match across editions. Windows launchers stay CRLF.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.swift text eol=lf
*.yml text eol=lf
# The OFL text and the web-edition denylist are line-oriented. A Windows autocrlf checkout
# must not turn the license sentence into CR LF, or append CR to a denylist regex.
*.txt text eol=lf
# Mark SHA-256s in jaryo/contract.mjs are of the LF bytes. A Windows checkout must not rewrite them.
*.svg text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
