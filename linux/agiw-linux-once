#!/bin/sh
# SSH forced command: native watchdog starts before Python startup or imports.
# Call this file by its absolute installed path, with no caller-supplied options.
if [ "$#" -ne 0 ]; then
    printf '%s\n' 'agiw-linux-once: accepts no arguments' >&2
    exit 64
fi
case "$0" in
    /*) ;;
    *) printf '%s\n' 'agiw-linux-once: invoke by absolute path' >&2; exit 64 ;;
esac
if [ ! -x /usr/bin/timeout ]; then
    printf '%s\n' 'agiw-linux-once: native deadline unavailable' >&2
    exit 69
fi
# GNU timeout owns a separate process group by default. KILL terminates Python
# and its probe children at 3.8 seconds, including when TERM is ignored. Keep
# the remaining 0.2 seconds for shell/watchdog startup and parent observation.
# Do not use --foreground: it would leave descendants outside the deadline.
# The Python entry resolves current to its immutable release before imports.
exec /usr/bin/timeout --signal=KILL 3.8s /usr/bin/python3 -I -B "${0%/*}/agiw-linux-status" --once
